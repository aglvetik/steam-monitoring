TELEGRAM_BOT_TOKEN=1234567890:your-telegram-bot-token
TELEGRAM_MAIN_CHANNEL_ID=@your_channel_or_chat_id
ADMIN_USER_IDS=123456789,987654321

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

STEAM_COUNTRY=DE
STEAM_LANGUAGE=russian
ENABLE_STEAM_STORE_SEARCH_SOURCE=true
STEAM_STORE_SEARCH_COUNT=100
STEAM_STORE_SEARCH_URL=https://store.steampowered.com/search/results/
ENABLE_STORE_PAGE_FREE_UNTIL_LOOKUP=true
STORE_PAGE_LOOKUP_DELAY_MS=800
ENABLE_STEAMDB_SOURCE=false
STEAMDB_FREE_PROMOTIONS_URL=https://steamdb.info/upcoming/free/
STEAMDB_USER_AGENT=steam-free-games-bot/0.1 contact: telegram
STEAMDB_TIMEOUT_SECONDS=20
CHECK_INTERVAL_MINUTES=60
RUN_STARTUP_CHECK=false

DATABASE_URL=sqlite://data/bot.sqlite
RUST_LOG=info
